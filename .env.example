# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime or configure in Vercel / environment.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Fallback Gemini Model when primary model is under high demand (defaults to gemini-flash-latest)
GEMINI_FALLBACK_MODEL=gemini-flash-latest

